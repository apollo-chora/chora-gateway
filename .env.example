# Local configuration for chora-gateway.
# Copy to .env and fill in values. Never commit .env or secrets.

PORT=8080
CHORA_ENV=local
CHORA_SOURCE_PROJECT=chora-local

# Chora session JWT (HS256) — the signer is shared with chora-identity.
CHORA_SESSION_SIGNER=change-me-to-a-32-byte-minimum-signing-key
CHORA_SESSION_ISSUER=https://api.chora.site
CHORA_SESSION_AUDIENCE=chora-local
CHORA_SESSION_TTL_SECONDS=3600

# chora-identity base URL (username/password verify-credentials + passkey).
CHORA_IDENTITY_URL=http://identity:8080

# Upstream services (required at boot).
SVC_TENANCY_URL=http://tenancy:8080
SVC_CREATION_URL=http://creation:8080
SVC_CONSUMPTION_URL=http://consumption:8080
SVC_SHARING_URL=http://sharing:8080
SVC_DELIVERY_URL=http://delivery:8080
SVC_GOVERNANCE_URL=http://governance:8080
SVC_OBSERVABILITY_URL=http://observability:8080
SVC_NOTIFICATIONS_URL=http://notifications:8080

# Tracing — OTLP/gRPC endpoint (the OTel Collector). Unset falls back to stdout.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# Self-hosted tracing UI base for O+ trace deep-links. Unset omits the link.
CHORA_TRACE_UI_URL=

# Event bus — NATS JetStream (chora-common/eventbus). Unset disables the bus.
NATS_URL=nats://nats:4222

# Optional: disable the mint route in local dev.
# MINT_DISABLED=true
